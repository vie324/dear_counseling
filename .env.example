# ============================================================
# Dear 美容整体 問診票 — 環境変数テンプレート
# このファイルを .env.local にコピーして値を埋めてください。
# `cp .env.example .env.local`
# ============================================================

# ---------- Supabase ----------
# Supabase ダッシュボード → Project Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service Role キー（公開フォーム送信時に RLS をバイパスして INSERT する用。サーバー専用・絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- Claude API（AI事前サマリー生成）----------
# https://console.anthropic.com/ で取得。未設定でも動作します（サマリーがスキップされるだけ）
ANTHROPIC_API_KEY=sk-ant-...

# ---------- LINE ----------
# LINE Developers コンソール → LIFF から取得（お客様がリッチメニューからフォームを開く用）
# 未設定でも動作します（通常のWebフォームとして開ける）
NEXT_PUBLIC_LIFF_ID=1234567890-abcdefgh
# Messaging API チャネルの「チャネルアクセストークン（長期）」（スタッフへの新着通知用）
LINE_CHANNEL_ACCESS_TOKEN=
# Messaging API チャネルの「チャネルシークレット」（Webhook 署名検証用）
LINE_CHANNEL_SECRET=
# 新着問診をプッシュ通知する送信先（スタッフのLINEユーザーID または グループID）。カンマ区切りで複数可
LINE_STAFF_NOTIFY_TO=

# ---------- アプリ ----------
# 通知メッセージ内のリンク生成に使用（本番のデプロイURL）
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
